# Values read by docker compose. Copy to .env to override the local defaults.
# Every default below is for local development only.

# Shared secret for POST /api/monitor/run-once and /api/changelogs/generate
ADMIN_SECRET=dev-secret

# HMAC secret the gateway uses to verify incoming webhooks
WEBHOOK_HMAC_SECRET=dev-webhook-secret
WEBHOOK_MAX_BODY_BYTES=262144

# Optional. Without a key the monitor writes template changelogs.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Browser origins allowed by the monitor and runtime APIs
FRONTEND_ORIGINS=http://localhost:5173

# Runtime guard
EVENT_BACKEND=noop
UVICORN_WORKERS=1
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
